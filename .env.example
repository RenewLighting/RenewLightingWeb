# Resend API key - get from https://resend.com/api-keys
RESEND_API_KEY=

# Where consultation requests are sent
CONTACT_EMAIL=

# From address - must be on a verified domain in Resend
RESEND_FROM_EMAIL=

# Google OAuth credentials for the employee-only warehouse
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Warehouse subdomain and the shared cookie-signing secret
INVENTORY_ORIGIN=https://warehouse.renewlighting.com
WAREHOUSE_PROXY_SECRET=

# Shared Supabase/Postgres connection used by saved quotes
DATABASE_URL=

# Server-side Claude API access for evidence-based fixture recommendations
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Microsoft Graph app registration and the existing shared quote folder
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_ROOT_FOLDER_ID=

# HMAC secret for email open-tracking pixel tokens
EMAIL_TRACKING_SECRET=
